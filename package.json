{
  "name": "unu-raymi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:admin": "npm --workspace=admin run dev",
    "start": "node server.js",
    "build": "node postinstall.cjs",
    "postinstall": "node postinstall.cjs",
    "build:backend": "npm --workspace=backend run build",
    "start:backend": "APP_TYPE=backend node server.js",
    "build:admin": "npm --workspace=admin run build",
    "start:admin": "APP_TYPE=admin node server.js",
    "build:frontend": "npm --workspace=frontend run build",
    "start:frontend": "APP_TYPE=frontend node server.js"
  },
  "main": "server.js",
  "workspaces": [
    "backend",
    "admin",
    "frontend",
    "docs"
  ]
}
