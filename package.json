{
  "name": "unu-raymi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:admin": "npm --workspace=admin run dev",
    "dev:setup": "npm --workspace=backend run db:local:generate",
    "dev:db": "npm --workspace=backend run db:studio",
    "start": "node server.js",
    "build": "node postinstall.cjs",
    "postinstall": "node postinstall.cjs",
    "build:backend": "node postinstall.cjs backend",
    "start:backend": "APP_TYPE=backend node server.js",
    "build:admin": "node postinstall.cjs admin",
    "start:admin": "APP_TYPE=admin node server.js",
    "build:frontend": "node postinstall.cjs frontend",
    "start:frontend": "APP_TYPE=frontend node server.js"
  },
  "main": "server.js",
  "workspaces": [
    "backend",
    "admin",
    "frontend"
  ],
  "dependencies": {
    "express": "^4.22.3"
  }
}
