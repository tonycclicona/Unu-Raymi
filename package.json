{
  "name": "unu-raymi",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:admin": "pnpm --filter admin dev",
    "start": "node server.js",
    "build": "node postinstall.cjs",
    "postinstall": "node postinstall.cjs",

    "install:backend": "pnpm --filter backend install",
    "build:backend": "pnpm --filter backend build",
    "start:backend": "APP_TYPE=backend node server.js",

    "install:admin": "pnpm --filter admin install",
    "build:admin": "pnpm --filter admin build",
    "start:admin": "APP_TYPE=admin node server.js",

    "install:frontend": "pnpm --filter frontend install",
    "build:frontend": "pnpm --filter frontend build",
    "start:frontend": "APP_TYPE=frontend node server.js"
  },
  "main": "server.js",
  "workspaces": [
    "backend",
    "admin",
    "frontend"
  ],
  "pnpm": {
    "workspaces": [
      "backend",
      "admin",
      "frontend"
    ]
  }
}
