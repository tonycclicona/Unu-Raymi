# ── Unu-Raymi Monorepo — .gitignore ──────────────────────────

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Gemini / AI Agent
.gemini/
*AGENTS.md
*CLAUDE.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment variables & secrets (NUNCA subir a Git)
*.env
*.env.*
*.env*.local
*.env.production.local
EnvironmentVariables.env
!*.env.example

# Dependencies
node_modules/

# ── Artefactos de build (generados por postinstall / npm run build) ──────────
# NUNCA deben estar en Git — Hostinger los genera al hacer npm install
out/
frontend/out/
admin/out/
backend/dist/
.next/
frontend/.next/
admin/.next/

# ── Bases de datos locales ────────────────────────────────────────────────────
backend/prisma/dev.db
backend/prisma/dev.db-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── Archivos temporales y de control de proceso ───────────────────────────────
tmp/
.port
*.port
api/.port
backend/.port
*.port_meta.json
.port_meta.json
api/.port_meta.json
backend/.port_meta.json

# ── public_html (generado por postinstall, no debe rastrearse) ────────────────
public_html/

# ── Prisma: solo schema SQLite local (MySQL/producción se mantiene) ───────────
backend/prisma/schema.sqlite.prisma

# ── Uploads de usuario (archivos subidos en runtime, no assets del repo) ─────
# Los assets estáticos del frontend (videos, logo) SÍ están en frontend/public/
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep


