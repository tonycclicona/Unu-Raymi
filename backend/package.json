{
  "name": "unu-raymi-backend",
  "version": "1.0.0",
  "description": "API Backend para el Sistema de Reservas de Tours Unu-Raymi",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node dist/server.js",
    "build": "node build.js && npx prisma generate",
    "postinstall": "node build.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:local:generate": "npx prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:local:push": "npx prisma db push --schema=prisma/schema.sqlite.prisma"
  },

  "keywords": [
    "tours",
    "reservas",
    "express",
    "prisma",
    "mysql"
  ],
  "author": "Unu-Raymi Dev Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.18.0",
    "prisma": "^5.22.0",
    "resend": "^6.28.0",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
