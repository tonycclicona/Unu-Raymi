<IfModule mod_rewrite.c>
RewriteEngine On

# Si el archivo estático solicitado existe físicamente (ej: uploads/foto.webp), servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
